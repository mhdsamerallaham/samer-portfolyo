{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/blog/generate",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/faq/generate",
      "schedule": "0 10 * * *"
    }
  ],
  "routes": [
    { "src": "/sitemap.xml", "dest": "/api/sitemap" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
